# Copie para .env.deploy na VM (fora do Git) e gere valores aleatórios:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
DB_OWNER_PASSWORD=REPLACE_WITH_RANDOM
DB_APP_PASSWORD=REPLACE_WITH_RANDOM
# hex, 32 bytes ou mais: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_KEY=REPLACE_WITH_RANDOM_HEX
# IP público da VM com hífens + .sslip.io (ex.: 129-151-10-20.sslip.io) ou um domínio seu apontado para a VM.
PUBLIC_HOST=REPLACE_WITH_HOST
