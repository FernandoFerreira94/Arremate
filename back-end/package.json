{
  "name": "@casadeleilao/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --testPathPatterns=integration",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file-if-exists=../.env -r ts-node/register prisma/seed.ts",
    "db:reset-demo": "node --env-file-if-exists=../.env -r ts-node/register prisma/reset-demo.ts",
    "audit:retry": "node --env-file-if-exists=../.env -r ts-node/register prisma/audit-retry.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2"
  }
}
