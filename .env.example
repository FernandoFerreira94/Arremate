# Valores locais; copie e gere senhas aleatórias. Nunca usar em produção.
DB_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
DB_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
DB_TEST_APP_PASSWORD=REPLACE_WITH_RANDOM_TEST_PASSWORD
DATABASE_URL=postgresql://auction_app:REPLACE_WITH_RANDOM_APP_PASSWORD@127.0.0.1:5462/casadeleilao
TEST_DATABASE_URL=postgresql://auction_app:REPLACE_WITH_RANDOM_TEST_PASSWORD@127.0.0.1:5463/casadeleilao_test
API_PORT=4300
API_HOST=127.0.0.1
SITE_URL=http://localhost:3300

# Opcional local; no runner de migration hospedado use conexão direta/Session, nunca a credencial runtime.
DIRECT_URL=
# Botoes de login rapido de teste (contas ficticias do seed, senha publica de demo). Sem segredo.
NEXT_PUBLIC_DEMO_LOGIN=true
# D31: licitantes automáticos da demo (licitante2..4 cobrem quem lidera). Desligado sem DEMO_BOTS=1; nunca em NODE_ENV=test.
DEMO_BOTS=
DEMO_BOT_INTERVAL_MS=15000
DEMO_BOT_MAX_BIDS=2
DEMO_BOT_CEILING=3
DEMO_BOT_MAX_PER_LOT=12
DEMO_BOT_EMAILS=
