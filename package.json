{
  "name": "casadeleilao",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "front-end",
    "back-end"
  ],
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev:web": "npm run dev --workspace front-end",
    "dev:api": "npm run dev --workspace back-end",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.tools.json",
    "test": "npm run test:unit --workspace back-end",
    "test:integration": "npm run test:integration --workspace back-end",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "audit:retry": "npm run audit:retry --workspace back-end",
    "db:validate": "npm run db:validate --workspace back-end",
    "db:generate": "npm run db:generate --workspace back-end"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
